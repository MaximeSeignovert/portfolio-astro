---
interface Props {
  index: string
  title: string
}

const { index, title } = Astro.props
---

<div class="flex items-baseline gap-3 md:gap-4 mb-4">
  <span class="text-xs md:text-sm text-muted-foreground font-mono">({index})</span>
  <h2 class="text-3xl sm:text-5xl md:text-7xl font-black uppercase tracking-[-0.03em]">
    {title}
  </h2>
</div>
<div class="w-full h-px bg-foreground/10 mb-10 md:mb-16"></div>
