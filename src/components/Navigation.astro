---
import { Menu, X } from '@lucide/astro'

const links = [
  { label: 'A propos', href: '#about' },
  { label: 'Expériences', href: '#experience' },
  { label: 'Projets', href: '#projects' },
  { label: 'Contact', href: '#contact' },
]
---

<nav class="fixed top-0 left-0 w-full z-40">
  {/* Desktop & mobile bar */}
  <div class="bg-background/80 backdrop-blur-sm border-b border-foreground/5">
    <div class="max-w-6xl mx-auto px-5 md:px-12 h-14 flex items-center justify-between">
      <a href="#home" class="text-sm font-bold tracking-tight uppercase" aria-label="Retour en haut de page">
        M.S
      </a>

      {/* Desktop links */}
      <div class="hidden md:flex gap-8">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-xs uppercase tracking-[0.15em] text-muted-foreground hover:text-foreground transition-colors duration-300"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      {/* Mobile menu button */}
      <button
        id="nav-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
        class="md:hidden p-1 text-foreground"
      >
        <Menu id="nav-icon-open" class="size-5" />
        <X id="nav-icon-close" class="size-5 hidden" />
      </button>
    </div>
  </div>

  {/* Mobile overlay */}
  <div
    id="nav-menu"
    class="hidden md:hidden fixed inset-0 top-14 bg-background/95 backdrop-blur-md z-50"
  >
    <div class="flex flex-col items-start gap-8 px-8 pt-12">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-2xl font-bold uppercase tracking-[0.05em] text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle')
  const menu = document.getElementById('nav-menu')
  const iconOpen = document.getElementById('nav-icon-open')
  const iconClose = document.getElementById('nav-icon-close')

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return
    menu.classList.toggle('hidden', !open)
    iconOpen?.classList.toggle('hidden', open)
    iconClose?.classList.toggle('hidden', !open)
    toggle.setAttribute('aria-expanded', String(open))
    document.body.style.overflow = open ? 'hidden' : ''
  }

  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false)
  })

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false))
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false)
  })
</script>
