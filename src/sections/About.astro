---
import aboutData from '@/data/about.json'
import formations from '@/data/formations.json'
import SectionHeader from '@/components/SectionHeader.astro'
---

<section id="about" class="py-16 md:py-32">
  <div class="max-w-6xl mx-auto px-5 md:px-12">
    <SectionHeader index="01" title="A propos" />

    {/* Content grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-24">
      {/* Left - text */}
      <div class="space-y-5 md:space-y-6">
        <p class="text-base sm:text-lg md:text-xl leading-relaxed">
          {aboutData.intro}
        </p>
        <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
          {aboutData.description}
        </p>
      </div>

      {/* Right - education & skills */}
      <div class="space-y-10 md:space-y-12">
        {/* Education */}
        <div>
          <h3 class="text-xs uppercase tracking-[0.2em] text-muted-foreground mb-3 md:mb-4">
            Formation
          </h3>
          <div class="space-y-4">
            {
              formations.map((f) => (
                <div>
                  <p class="text-base sm:text-lg font-semibold">{f.ecole}</p>
                  <p class="text-sm sm:text-base text-muted-foreground">{f.diplome}</p>
                  <p class="text-xs text-muted-foreground/60 font-mono mt-0.5">
                    {f.date} · {f.lieu}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        {/* Skills */}
        <div>
          <h3 class="text-xs uppercase tracking-[0.2em] text-muted-foreground mb-3 md:mb-4">
            Technologies
          </h3>
          <div class="flex flex-wrap gap-2 md:gap-3">
            {
              aboutData.skills.map((skill) => (
                <span class="text-xs sm:text-sm border border-foreground/15 px-2.5 sm:px-3 py-1 sm:py-1.5 hover:bg-foreground hover:text-background transition-colors duration-300">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
