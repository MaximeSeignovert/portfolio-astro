---
import aboutData from '@/data/about.json'
import { SITE } from '@/consts'
import SectionHeader from '@/components/SectionHeader.astro'
import { ArrowUpRight } from '@lucide/astro'

const year = new Date().getFullYear()

const socials = [
  { label: 'GitHub', href: SITE.github, external: true },
  { label: 'LinkedIn', href: SITE.linkedin, external: true },
  { label: SITE.email, href: `mailto:${SITE.email}`, external: false },
]
---

<section id="contact" class="py-16 md:py-32">
  <div class="max-w-6xl mx-auto px-5 md:px-12">
    <SectionHeader index="04" title="Contact" />

    {/* Content */}
    <div class="max-w-2xl">
      <p class="text-lg sm:text-xl md:text-2xl leading-relaxed">{aboutData.cta}</p>
      <div class="flex flex-wrap gap-6 mt-8 md:mt-10">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target={social.external ? '_blank' : undefined}
              rel={social.external ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-2 text-sm sm:text-base font-semibold border-b-2 border-foreground pb-1 hover:gap-4 transition-all duration-300"
            >
              {social.label}
              <ArrowUpRight class="size-4" />
            </a>
          ))
        }
      </div>
    </div>

    {/* Footer */}
    <footer
      class="mt-16 md:mt-32 pt-6 md:pt-8 border-t border-foreground/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4"
    >
      <p class="text-xs sm:text-sm text-muted-foreground">
        &copy; {year} {SITE.name}
      </p>
      <p class="text-[11px] sm:text-xs text-muted-foreground/50 uppercase tracking-[0.15em]">
        Construit avec Astro &amp; Tailwind
      </p>
    </footer>
  </div>
</section>
