---
import experiences from '@/data/experiences.json'
import SectionHeader from '@/components/SectionHeader.astro'
---

<section id="experience" class="py-16 md:py-32">
  <div class="max-w-6xl mx-auto px-5 md:px-12">
    <SectionHeader index="02" title="Expériences" />

    {/* Experience list */}
    <div>
      {
        experiences.map((exp, i) => (
          <div>
            <article class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-2 md:gap-12 py-6 md:py-10">
              {/* Date & location */}
              <div class="flex md:flex-col gap-2 md:gap-1">
                <p class="text-xs sm:text-sm text-muted-foreground font-mono">{exp.date}</p>
                <p class="text-xs sm:text-sm text-muted-foreground/50">{exp.lieu}</p>
              </div>

              {/* Content */}
              <div>
                <h3 class="text-lg sm:text-xl md:text-2xl font-bold">{exp.title}</h3>
                <p class="text-sm sm:text-base text-muted-foreground mt-1">{exp.entreprise}</p>
                <p class="text-sm sm:text-base text-muted-foreground/80 mt-3 md:mt-4 leading-relaxed">
                  {exp.description}
                </p>
                {exp.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 sm:gap-2 mt-3 md:mt-4">
                    {exp.tags.map((tag) => (
                      <span class="text-[11px] sm:text-xs border border-foreground/10 px-2 sm:px-2.5 py-0.5 sm:py-1 text-muted-foreground">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
            {i < experiences.length - 1 && <div class="w-full h-px bg-foreground/5" />}
          </div>
        ))
      }
    </div>
  </div>
</section>
