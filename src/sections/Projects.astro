---
import projets from '@/data/projets.json'
import SectionHeader from '@/components/SectionHeader.astro'
import { ArrowUpRight, ExternalLink, ImageOff, X } from '@lucide/astro'

const indexed = projets.map((project, index) => ({ ...project, index }))
const featured = indexed.filter((p) => p.featured)
const others = indexed.filter((p) => !p.featured)

const drawerAttrs = (project: (typeof indexed)[number]) => ({
  'data-project-index': project.index,
  'data-project-title': project.title,
  'data-project-date': project.date,
  'data-project-description': project.description,
  'data-project-link': project.lien,
  'data-project-image': project.lienImage,
  'data-project-tags': project.tags.join('|'),
})
---

<section id="projects" class="py-16 md:py-32">
  <div class="max-w-6xl mx-auto px-5 md:px-12">
    <SectionHeader index="03" title="Projets" />

    {/* Featured projects grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-foreground/5">
      {
        featured.map((project) => (
          <div>
            <button
              type="button"
              aria-haspopup="dialog"
              {...drawerAttrs(project)}
              class="group bg-background text-left p-6 flex sm:hidden w-full flex-col justify-between min-h-[220px] hover:bg-foreground hover:text-background transition-colors duration-500"
            >
              <div>
                <div class="flex items-start justify-between">
                  <h3 class="text-xl font-bold">{project.title}</h3>
                  <ArrowUpRight class="size-5 shrink-0 mt-1" />
                </div>
                <p class="text-xs text-muted-foreground group-hover:text-background/60 mt-1.5 transition-colors duration-500">
                  {project.date}
                </p>
                <p class="text-sm mt-3 text-muted-foreground group-hover:text-background/70 leading-relaxed transition-colors duration-500">
                  {project.description}
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 mt-4">
                {project.tags.map((tag) => (
                  <span class="text-[11px] border border-foreground/10 group-hover:border-background/20 px-2 py-0.5 transition-colors duration-500">
                    {tag}
                  </span>
                ))}
              </div>
            </button>
            <a
              href={project.lien}
              target="_blank"
              rel="noopener noreferrer"
              class="group bg-background p-6 sm:p-8 md:p-10 hidden sm:flex flex-col justify-between min-h-[220px] sm:min-h-[260px] md:min-h-[280px] hover:bg-foreground hover:text-background transition-colors duration-500"
            >
              <div>
                <div class="flex items-start justify-between">
                  <h3 class="text-xl sm:text-2xl md:text-3xl font-bold">{project.title}</h3>
                  <ArrowUpRight class="size-4 sm:size-5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 shrink-0 mt-1" />
                </div>
                <p class="text-xs sm:text-sm text-muted-foreground group-hover:text-background/60 mt-1.5 sm:mt-2 transition-colors duration-500">
                  {project.date}
                </p>
                <p class="text-sm sm:text-base mt-3 sm:mt-4 text-muted-foreground group-hover:text-background/70 leading-relaxed transition-colors duration-500">
                  {project.description}
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 sm:gap-2 mt-4 sm:mt-6">
                {project.tags.map((tag) => (
                  <span class="text-[11px] sm:text-xs border border-foreground/10 group-hover:border-background/20 px-2 sm:px-2.5 py-0.5 sm:py-1 transition-colors duration-500">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          </div>
        ))
      }
    </div>

    {/* Other projects */}
    {
      others.length > 0 && (
        <div class="mt-12 md:mt-20">
          <h3 class="text-xs uppercase tracking-[0.2em] text-muted-foreground mb-6 md:mb-8">
            Autres projets
          </h3>
          <div>
            {others.map((project, i) => (
              <div>
                <button
                  type="button"
                  aria-haspopup="dialog"
                  {...drawerAttrs(project)}
                  class="group flex sm:hidden w-full text-left items-start justify-between py-4"
                >
                  <div class="flex flex-col min-w-0">
                    <span class="text-base font-semibold truncate">{project.title}</span>
                    <span class="text-xs text-muted-foreground mt-1">
                      {project.tags.join(', ')}
                    </span>
                  </div>
                  <ArrowUpRight class="size-4 text-muted-foreground shrink-0 mt-1 ml-4" />
                </button>
                <a
                  href={project.lien}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group hidden sm:flex flex-col sm:flex-row sm:items-start sm:justify-between py-4 hover:sm:pl-4 transition-all duration-300"
                >
                  <div class="flex flex-col min-w-0">
                    <div class="flex items-baseline gap-3 sm:gap-4">
                      <span class="text-base sm:text-lg md:text-xl font-semibold group-hover:underline underline-offset-4 truncate">
                        {project.title}
                      </span>
                      <span class="text-xs sm:text-sm text-muted-foreground hidden md:inline shrink-0">
                        {project.tags.join(', ')}
                      </span>
                    </div>
                    <p class="text-xs text-muted-foreground overflow-hidden max-h-0 group-hover:max-h-10 opacity-0 group-hover:opacity-100 transition-all duration-300 mt-0 group-hover:mt-1 leading-relaxed pr-4">
                      {project.description}
                    </p>
                  </div>
                  <span class="text-xs sm:text-sm text-muted-foreground font-mono shrink-0 mt-1 sm:mt-0 sm:ml-4">
                    {project.date}
                  </span>
                </a>
                {i < others.length - 1 && <div class="w-full h-px bg-foreground/5" />}
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>

  {/* Mobile project drawer */}
  <div id="project-drawer-root" class="fixed inset-0 z-40 sm:hidden" hidden aria-live="polite">
    <button
      type="button"
      id="project-drawer-backdrop"
      aria-label="Fermer les détails du projet"
      class="absolute inset-0 bg-foreground/50 backdrop-blur-[2px]"
    >
    </button>
    <aside
      role="dialog"
      aria-modal="true"
      aria-labelledby="project-drawer-title"
      aria-describedby="project-drawer-description"
      class="project-drawer absolute inset-x-0 bottom-0 max-h-[88dvh] overflow-y-auto border-t-2 border-foreground bg-background px-5 pb-[calc(1.5rem+env(safe-area-inset-bottom))] pt-5 text-foreground"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-[10px] uppercase tracking-[0.22em] text-muted-foreground">
            Détails du projet
          </p>
          <h3
            id="project-drawer-title"
            class="mt-2 text-3xl font-black uppercase tracking-[-0.03em]"
          >
          </h3>
        </div>
        <button
          type="button"
          id="project-drawer-close"
          aria-label="Fermer"
          class="inline-flex size-10 shrink-0 items-center justify-center border border-foreground/15 transition-colors hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
        >
          <X class="size-5" />
        </button>
      </div>

      <div class="mt-6 grid grid-cols-[5rem_1fr] gap-4 border-y border-foreground/10 py-4">
        <div class="flex size-20 items-center justify-center overflow-hidden border border-foreground/10 bg-foreground/5">
          <img
            id="project-drawer-image"
            src=""
            alt=""
            class="size-12 object-contain"
            loading="lazy"
            decoding="async"
          />
          <div
            id="project-drawer-image-fallback"
            class="hidden flex-col items-center gap-1 text-muted-foreground"
          >
            <ImageOff class="size-6" />
            <span class="text-[9px] uppercase tracking-[0.12em]">Aperçu indisponible</span>
          </div>
        </div>
        <div class="flex flex-col justify-center">
          <p id="project-drawer-date" class="text-xs font-mono text-muted-foreground"></p>
          <p id="project-drawer-description" class="mt-2 text-sm leading-relaxed"></p>
        </div>
      </div>

      <div class="mt-5">
        <p class="text-[10px] uppercase tracking-[0.22em] text-muted-foreground">Stack utilisée</p>
        <div id="project-drawer-tags" class="mt-3 flex flex-wrap gap-2"></div>
      </div>

      <a
        id="project-drawer-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 flex min-h-12 items-center justify-between bg-foreground px-4 text-sm font-semibold text-background transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
      >
        <span>Voir le projet</span>
        <ExternalLink class="size-4" />
      </a>
    </aside>
  </div>
</section>

<script>
  const root = document.getElementById('project-drawer-root')
  const backdrop = document.getElementById('project-drawer-backdrop')
  const closeButton = document.getElementById('project-drawer-close')
  const linkButton = document.getElementById('project-drawer-link')
  const titleEl = document.getElementById('project-drawer-title')
  const dateEl = document.getElementById('project-drawer-date')
  const descriptionEl = document.getElementById('project-drawer-description')
  const imageEl = document.getElementById('project-drawer-image') as HTMLImageElement | null
  const imageFallback = document.getElementById('project-drawer-image-fallback')
  const tagsEl = document.getElementById('project-drawer-tags')
  const triggers = document.querySelectorAll<HTMLElement>('[data-project-index]')

  let previouslyFocused: HTMLElement | null = null

  imageEl?.addEventListener('error', () => {
    imageEl.classList.add('hidden')
    imageFallback?.classList.remove('hidden')
    imageFallback?.classList.add('flex')
  })

  const closeDrawer = () => {
    if (!root) return
    root.setAttribute('hidden', '')
    document.body.style.overflow = ''
    previouslyFocused?.focus()
  }

  const openDrawer = (trigger: HTMLElement) => {
    if (!root) return

    previouslyFocused = document.activeElement as HTMLElement | null

    if (titleEl) titleEl.textContent = trigger.dataset.projectTitle ?? ''
    if (dateEl) dateEl.textContent = trigger.dataset.projectDate ?? ''
    if (descriptionEl) descriptionEl.textContent = trigger.dataset.projectDescription ?? ''

    if (imageEl) {
      imageEl.classList.remove('hidden')
      imageFallback?.classList.add('hidden')
      imageFallback?.classList.remove('flex')
      imageEl.src = trigger.dataset.projectImage ?? ''
    }

    if (tagsEl) {
      tagsEl.innerHTML = ''
      const tags = (trigger.dataset.projectTags ?? '').split('|').filter(Boolean)
      for (const tag of tags) {
        const span = document.createElement('span')
        span.className = 'border border-foreground/15 px-2.5 py-1 text-xs'
        span.textContent = tag
        tagsEl.appendChild(span)
      }
    }

    if (linkButton) {
      linkButton.setAttribute('href', trigger.dataset.projectLink ?? '#')
    }

    root.removeAttribute('hidden')
    document.body.style.overflow = 'hidden'
    closeButton?.focus()
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => openDrawer(trigger))
  })

  backdrop?.addEventListener('click', closeDrawer)
  closeButton?.addEventListener('click', closeDrawer)
  linkButton?.addEventListener('click', closeDrawer)

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && root && !root.hasAttribute('hidden')) closeDrawer()
  })
</script>
